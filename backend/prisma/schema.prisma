generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/planes.sqlite"
}

model Planes {
  id            Int     @id @default(autoincrement())
  icao24        String
  callsign      String?
  originCountry String?
  velocity      Float?
  latitude      Float?
  longitude     Float?
}
